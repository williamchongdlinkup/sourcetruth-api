# ── Corpus database accounts ──────────────────────────────────────────────────
# Account 1 — primary (auth, logging, entity resolution + corpus data)
DATABASE_URL=postgresql://user:password@host:5432/corpusapi

# Account 2 — overflow corpus data (add when account 1 nears storage limit)
# DATABASE_URL_2=postgresql://user2:password2@host2:5432/corpusapi

# Account 3 — further overflow
# DATABASE_URL_3=postgresql://user3:password3@host3:5432/corpusapi

# ── AI providers ──────────────────────────────────────────────────────────────
# Anthropic — /v1/answer generation (claude-sonnet-4-6)
ANTHROPIC_API_KEY=sk-ant-...

# Voyage AI — multilingual embeddings (voyage-multilingual-2, 1024 dim)
# Handles all 12 vertical scripts: Latin, Arabic, Hebrew, Devanagari, CJK, Tibetan, Gurmukhi
VOYAGE_API_KEY=pa-...

# ── API server ────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8001
ALLOWED_ORIGINS=http://localhost:3000

# Key prefix — update this to the chosen product name before launch
# e.g. scroll_ for ScrollAPI, canon_ for CanonAPI, etc.
API_KEY_PREFIX=st_

# ── Billing (Stripe) — add before launch ─────────────────────────────────────
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_STARTER_PRICE_ID=price_...
# STRIPE_PROFESSIONAL_PRICE_ID=price_...

# ── Frontend / playground ────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
SEARCH_API_URL=http://localhost:8001

# ── Corpus data paths ────────────────────────────────────────────────────────
DATA_DIR=data
SC_DATA_DIR=data/raw/suttacentral
CBETA_DATA_DIR=data/raw/cbeta
BDRC_DATA_DIR=data/raw/bdrc
GRETIL_DATA_DIR=data/raw/gretil
QURAN_DATA_DIR=data/raw/quran
BIBLE_DATA_DIR=data/raw/bible
TANAKH_DATA_DIR=data/raw/tanakh
HINDU_DATA_DIR=data/raw/hindu
CLASSICAL_DATA_DIR=data/raw/classical
SGGS_DATA_DIR=data/raw/sggs
